# Local installer/download artifacts.
=1.4.4
.tools/*
!.tools/.gitignore

# Textbook PDFs are local inputs and may be copyrighted; import them separately.
*.pdf

# Review manifests can contain copyrighted textbook excerpts.
configs/*.review.json

# Generated build metadata and local credential/certificate files.
*.tsbuildinfo
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.pem
*.key
*.p12
*.pfx
*.log
